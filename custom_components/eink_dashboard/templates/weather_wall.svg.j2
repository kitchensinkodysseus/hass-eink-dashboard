{#- Weather wall: a full-panel layout for a six-colour e-ink
    display.  All geometry arrives pre-computed from
    _build_weather_wall_context(); this template only draws.

    The palette is the panel's four usable native states: blue
    ground, white, black and yellow.  Nothing here dithers.

    The weather icons are defined inline rather than loaded from
    icons/svg/, because _build_inline_svg() flattens every path to
    a single colour and would lose the yellow sun and the black
    rain-bearing cloud.  The cloud shape is repeated in full in
    each icon rather than referenced, since resvg's handling of a
    <use> that points at another <use> is not guaranteed. -#}
{%- set c_bg = "#0000FF" -%}
{%- set c_fg = "#FFFFFF" -%}
{%- set c_dark = "#000000" -%}
{%- set c_warn = "#FF0000" -%}
{%- set c_sun = "#FFFF00" -%}
<svg xmlns="http://www.w3.org/2000/svg"
     width="{{ w }}" height="{{ h }}">
<defs>
<g id="ww-wind">
  <path d="M -8 -3 h 9 a 3 3 0 1 0 -3 -3" fill="none"
        stroke="{{ c_fg }}" stroke-width="1.5"
        stroke-linecap="round"/>
  <path d="M -8 1 h 12 a 3 3 0 1 1 -3 3" fill="none"
        stroke="{{ c_fg }}" stroke-width="1.5"
        stroke-linecap="round"/>
</g>
<g id="ww-horizon">
  <path d="M -6.5 3 A 6.5 6.5 0 0 1 6.5 3 Z" fill="{{ c_sun }}"/>
  <line x1="-9.5" y1="3.5" x2="9.5" y2="3.5"
        stroke="{{ c_fg }}" stroke-width="1.5"/>
  <line x1="0" y1="-6" x2="0" y2="-8.6"
        stroke="{{ c_sun }}" stroke-width="1.5"/>
  <line x1="-5.7" y1="-2.7" x2="-7.5" y2="-4.5"
        stroke="{{ c_sun }}" stroke-width="1.5"/>
  <line x1="5.7" y1="-2.7" x2="7.5" y2="-4.5"
        stroke="{{ c_sun }}" stroke-width="1.5"/>
</g>
<g id="ww-arm" fill="none">
  <line x1="0" y1="0" x2="0" y2="-7.5"/>
  <line x1="0" y1="-4.3" x2="2.3" y2="-5.9"/>
  <line x1="0" y1="-4.3" x2="-2.3" y2="-5.9"/>
</g>
<g id="ww-crystal" stroke="{{ c_fg }}" stroke-width="1.4"
   stroke-linecap="butt">
  <use href="#ww-arm"/>
  <use href="#ww-arm" transform="rotate(60)"/>
  <use href="#ww-arm" transform="rotate(120)"/>
  <use href="#ww-arm" transform="rotate(180)"/>
  <use href="#ww-arm" transform="rotate(240)"/>
  <use href="#ww-arm" transform="rotate(300)"/>
</g>
{#- Moon phases.  The lit limb is on the right when waxing, as
    seen from the northern hemisphere; the waning phases are the
    same paths mirrored. -#}
<g id="m-new"><circle cx="0" cy="0" r="9" fill="none"
   stroke="{{ c_fg }}" stroke-width="1.3"/></g>
<g id="m-crescent"><path
   d="M 0 -9 A 9 9 0 0 1 0 9 A 4 9 0 0 0 0 -9 Z"
   fill="{{ c_fg }}"/></g>
<g id="m-quarter"><path d="M 0 -9 A 9 9 0 0 1 0 9 Z"
   fill="{{ c_fg }}"/></g>
<g id="m-gibbous"><path
   d="M 0 -9 A 9 9 0 0 1 0 9 A 4 9 0 0 1 0 -9 Z"
   fill="{{ c_fg }}"/></g>
<g id="m-full"><circle cx="0" cy="0" r="9" fill="{{ c_fg }}"/></g>
{#- Weather icons, drawn in a 24-unit box centred on the origin.
    Every cloud sits at the same coordinates so precipitation
    hangs below rather than displacing the cloud upward. -#}
<g id="wx-sun">
  <circle cx="0" cy="0" r="6" fill="{{ c_sun }}"/>
  <g stroke="{{ c_sun }}" stroke-width="1.7">
    <line x1="0" y1="-8" x2="0" y2="-10.5"/>
    <line x1="0" y1="8" x2="0" y2="10.5"/>
    <line x1="-8" y1="0" x2="-10.5" y2="0"/>
    <line x1="8" y1="0" x2="10.5" y2="0"/>
    <line x1="-5.7" y1="-5.7" x2="-7.4" y2="-7.4"/>
    <line x1="5.7" y1="5.7" x2="7.4" y2="7.4"/>
    <line x1="5.7" y1="-5.7" x2="7.4" y2="-7.4"/>
    <line x1="-5.7" y1="5.7" x2="-7.4" y2="7.4"/>
  </g>
</g>
<g id="wx-moon-clear">
  <g transform="scale(1.15)"><use href="#m-gibbous"/></g>
</g>
<g id="wx-clear-night">
  <g transform="scale(1.15)"><use href="#m-gibbous"/></g>
</g>
<g id="wx-cloud" fill="{{ c_fg }}">
  <circle cx="-5" cy="1" r="5"/>
  <circle cx="2" cy="-3" r="7"/>
  <circle cx="8" cy="2" r="4.5"/>
  <rect x="-5" y="2" width="13" height="4.5"/>
</g>
<g id="wx-cloud-dark">
  <g fill="{{ c_fg }}">
    <circle cx="-5.2" cy="1" r="6.2"/>
    <circle cx="2.1" cy="-3.2" r="8.2"/>
    <circle cx="8.4" cy="2" r="5.7"/>
    <rect x="-5.2" y="1.8" width="13.6" height="5.9"/>
  </g>
  <g fill="{{ c_dark }}">
    <circle cx="-5" cy="1" r="5"/>
    <circle cx="2" cy="-3" r="7"/>
    <circle cx="8" cy="2" r="4.5"/>
    <rect x="-5" y="2" width="13" height="4.5"/>
  </g>
</g>
<g id="wx-sun-cloud">
  <circle cx="5" cy="-9" r="4.5" fill="{{ c_sun }}"/>
  <g stroke="{{ c_sun }}" stroke-width="1.5">
    <line x1="5" y1="-16" x2="5" y2="-18.2"/>
    <line x1="11" y1="-13" x2="12.8" y2="-14.4"/>
  </g>
  <g fill="{{ c_fg }}">
    <circle cx="-5" cy="1" r="5"/>
    <circle cx="2" cy="-3" r="7"/>
    <circle cx="8" cy="2" r="4.5"/>
    <rect x="-5" y="2" width="13" height="4.5"/>
  </g>
</g>
<g id="wx-moon-cloud">
  <g transform="translate(5,-11) scale(0.6)">
    <use href="#m-gibbous"/>
  </g>
  <g fill="{{ c_fg }}">
    <circle cx="-5" cy="1" r="5"/>
    <circle cx="2" cy="-3" r="7"/>
    <circle cx="8" cy="2" r="4.5"/>
    <rect x="-5" y="2" width="13" height="4.5"/>
  </g>
</g>
<g id="wx-rain1">
  <g fill="{{ c_fg }}">
    <circle cx="-5" cy="1" r="5"/>
    <circle cx="2" cy="-3" r="7"/>
    <circle cx="8" cy="2" r="4.5"/>
    <rect x="-5" y="2" width="13" height="4.5"/>
  </g>
  <line x1="2" y1="9" x2="0.5" y2="14"
        stroke="{{ c_fg }}" stroke-width="1.9"/>
</g>
<g id="wx-rain2">
  <g fill="{{ c_fg }}">
    <circle cx="-5.2" cy="1" r="6.2"/>
    <circle cx="2.1" cy="-3.2" r="8.2"/>
    <circle cx="8.4" cy="2" r="5.7"/>
    <rect x="-5.2" y="1.8" width="13.6" height="5.9"/>
  </g>
  <g fill="{{ c_dark }}">
    <circle cx="-5" cy="1" r="5"/>
    <circle cx="2" cy="-3" r="7"/>
    <circle cx="8" cy="2" r="4.5"/>
    <rect x="-5" y="2" width="13" height="4.5"/>
  </g>
  <g stroke="{{ c_fg }}" stroke-width="1.9">
    <line x1="-1" y1="9" x2="-2.5" y2="14"/>
    <line x1="5" y1="9" x2="3.5" y2="14"/>
  </g>
</g>
<g id="wx-rain3">
  <g fill="{{ c_fg }}">
    <circle cx="-5.2" cy="1" r="6.2"/>
    <circle cx="2.1" cy="-3.2" r="8.2"/>
    <circle cx="8.4" cy="2" r="5.7"/>
    <rect x="-5.2" y="1.8" width="13.6" height="5.9"/>
  </g>
  <g fill="{{ c_dark }}">
    <circle cx="-5" cy="1" r="5"/>
    <circle cx="2" cy="-3" r="7"/>
    <circle cx="8" cy="2" r="4.5"/>
    <rect x="-5" y="2" width="13" height="4.5"/>
  </g>
  <g stroke="{{ c_fg }}" stroke-width="1.9">
    <line x1="-4" y1="9" x2="-5.5" y2="14"/>
    <line x1="2" y1="9" x2="0.5" y2="14"/>
    <line x1="8" y1="9" x2="6.5" y2="14"/>
  </g>
</g>
<g id="wx-flake" stroke="{{ c_fg }}" stroke-width="1.3">
  <line x1="-2.2" y1="0" x2="2.2" y2="0"/>
  <line x1="-1.1" y1="-1.9" x2="1.1" y2="1.9"/>
  <line x1="-1.1" y1="1.9" x2="1.1" y2="-1.9"/>
</g>
<g id="wx-snow1">
  <g fill="{{ c_fg }}">
    <circle cx="-5" cy="1" r="5"/>
    <circle cx="2" cy="-3" r="7"/>
    <circle cx="8" cy="2" r="4.5"/>
    <rect x="-5" y="2" width="13" height="4.5"/>
  </g>
  <g transform="translate(2,11.5)"><use href="#wx-flake"/></g>
</g>
<g id="wx-snow2">
  <g fill="{{ c_fg }}">
    <circle cx="-5" cy="1" r="5"/>
    <circle cx="2" cy="-3" r="7"/>
    <circle cx="8" cy="2" r="4.5"/>
    <rect x="-5" y="2" width="13" height="4.5"/>
  </g>
  <g transform="translate(-1,11.5)"><use href="#wx-flake"/></g>
  <g transform="translate(5,11.5)"><use href="#wx-flake"/></g>
</g>
<g id="wx-snow3">
  <g fill="{{ c_fg }}">
    <circle cx="-5.2" cy="1" r="6.2"/>
    <circle cx="2.1" cy="-3.2" r="8.2"/>
    <circle cx="8.4" cy="2" r="5.7"/>
    <rect x="-5.2" y="1.8" width="13.6" height="5.9"/>
  </g>
  <g fill="{{ c_dark }}">
    <circle cx="-5" cy="1" r="5"/>
    <circle cx="2" cy="-3" r="7"/>
    <circle cx="8" cy="2" r="4.5"/>
    <rect x="-5" y="2" width="13" height="4.5"/>
  </g>
  <g transform="translate(-5,11.5)"><use href="#wx-flake"/></g>
  <g transform="translate(1,11.5)"><use href="#wx-flake"/></g>
  <g transform="translate(7,11.5)"><use href="#wx-flake"/></g>
</g>
<g id="wx-storm">
  <g fill="{{ c_fg }}">
    <circle cx="-5.2" cy="1" r="6.2"/>
    <circle cx="2.1" cy="-3.2" r="8.2"/>
    <circle cx="8.4" cy="2" r="5.7"/>
    <rect x="-5.2" y="1.8" width="13.6" height="5.9"/>
  </g>
  <g fill="{{ c_dark }}">
    <circle cx="-5" cy="1" r="5"/>
    <circle cx="2" cy="-3" r="7"/>
    <circle cx="8" cy="2" r="4.5"/>
    <rect x="-5" y="2" width="13" height="4.5"/>
  </g>
  <path d="M 2.4 5.6 L -1.0 11.6 L 2.0 10.2 L -1.4 16.2"
        fill="none" stroke="{{ c_sun }}" stroke-width="2.6"
        stroke-linecap="butt" stroke-linejoin="bevel"/>
</g>
<g id="wx-fog">
  <g fill="{{ c_fg }}">
    <circle cx="-5" cy="1" r="5"/>
    <circle cx="2" cy="-3" r="7"/>
    <circle cx="8" cy="2" r="4.5"/>
    <rect x="-5" y="2" width="13" height="4.5"/>
  </g>
  <g stroke="{{ c_fg }}" stroke-width="1.9" stroke-linecap="round">
    <line x1="-8" y1="10" x2="6" y2="10"/>
    <line x1="-5" y1="14" x2="9" y2="14"/>
  </g>
</g>
</defs>
<rect x="0" y="0" width="{{ w }}" height="{{ h }}" fill="{{ c_bg }}"/>
{%- if is_night -%}
<rect x="0" y="0" width="{{ night_w }}" height="{{ night_h }}"
      fill="{{ c_dark }}"/>
{%- endif -%}
{%- if not has_state -%}
<text x="{{ margin }}" y="{{ y_headline }}" font-size="{{ font_m }}"
      fill="{{ c_sun }}" font-family="Roboto"
  >No weather entity, or no forecast available</text>
{%- else -%}
<text x="{{ margin }}" y="{{ y_date }}" font-size="{{ font_s }}"
      fill="{{ c_fg }}" font-family="Roboto">{{ date_text }}</text>
{%- if header_left -%}
<text x="{{ hours[0].cx if hours else right_x }}" y="{{ y_date }}"
      font-size="{{ font_s }}" fill="{{ c_fg }}"
      font-family="Roboto">{{ header_left }}</text>
{%- endif -%}
{%- if header_max -%}
<text x="{{ right_right - 132 }}" y="{{ y_date }}"
      font-size="{{ font_s }}" text-anchor="end" fill="{{ c_fg }}"
      font-family="Roboto">{{ header_max }}</text>
{%- endif -%}
{%- if header_uv -%}
<text x="{{ right_right }}" y="{{ y_date }}" font-size="{{ font_s }}"
      text-anchor="end" fill="{{ c_fg }}"
      font-family="Roboto">{{ header_uv }}</text>
{%- endif -%}
{#- The hero: a moon phase when the sky is clear enough to show
    one, otherwise the weather condition. -#}
{%- if moon_phase -%}
<g transform="translate({{ hero_cx }}, {{ hero_cy }})
   scale({{ hero_scale }})">
{%- if moon_phase == 'new' -%}
<use href="#m-new"/>
{%- elif moon_phase == 'wax_crescent' -%}
<use href="#m-crescent"/>
{%- elif moon_phase == 'wane_crescent' -%}
<g transform="scale(-1,1)"><use href="#m-crescent"/></g>
{%- elif moon_phase == 'first_quarter' -%}
<use href="#m-quarter"/>
{%- elif moon_phase == 'last_quarter' -%}
<g transform="scale(-1,1)"><use href="#m-quarter"/></g>
{%- elif moon_phase == 'wax_gibbous' -%}
<use href="#m-gibbous"/>
{%- elif moon_phase == 'wane_gibbous' -%}
<g transform="scale(-1,1)"><use href="#m-gibbous"/></g>
{%- else -%}
<use href="#m-full"/>
{%- endif -%}
</g>
{%- elif hero_icon -%}
<g transform="translate({{ hero_cx }}, {{ hero_cy }})
   scale({{ hero_scale }})"><use href="#{{ hero_icon }}"/></g>
{%- endif -%}
{%- if headline.show -%}
<text x="{{ temp_x }}" y="{{ y_headline }}" font-size="{{ font_xl }}"
      font-weight="500" fill="{{ c_fg }}" font-family="Roboto"
  >{%- if headline.neg %}<tspan font-size="{{ minus_xl }}">&#8722;</tspan><tspan dx="{{ dx_xl }}">{{ headline.text }}</tspan>{% else %}{{ headline.text }}{% endif -%}</text>
{%- endif -%}
{%- if uv_show -%}
<text x="{{ left_right }}" y="{{ y_uv_label }}" font-size="{{ font_s }}"
      font-weight="600" text-anchor="end"
      fill="{{ c_warn if uv_warn else c_fg }}"
      font-family="Roboto">UV</text>
<text x="{{ left_right }}" y="{{ y_headline }}" font-size="{{ font_l }}"
      font-weight="600" text-anchor="end"
      fill="{{ c_warn if uv_warn else c_fg }}"
      font-family="Roboto">{{ uv_text }}</text>
{%- endif -%}
{%- if line2_kind == 'plain' -%}
<text x="{{ temp_x }}" y="{{ y_line2 }}" font-size="{{ font_m }}"
      fill="{{ c_fg }}" font-family="Roboto">{{ line2_text }}</text>
{%- elif line2_kind == 'solar' -%}
<g transform="translate({{ line2_icon_x }}, {{ y_line2 - 9 }})
   scale(1.5)"><use href="#ww-horizon"/></g>
<text x="{{ line2_text_x }}" y="{{ y_line2 }}" font-size="{{ font_m }}"
      fill="{{ c_fg }}" font-family="Roboto">{{ line2_text }}</text>
{%- elif line2_kind == 'warn' -%}
<g transform="translate({{ line2_icon_x }}, {{ y_line2 - 9 }})
   scale(1.5)"><use href="#ww-crystal"/></g>
<text x="{{ line2_text_x }}" y="{{ y_line2 }}" font-size="{{ font_m }}"
      fill="{{ c_fg }}" font-family="Roboto">{{ line2_text }}</text>
{%- endif -%}
{%- if wind_text -%}
<g transform="translate({{ wind_icon_x }}, {{ y_metrics - 6 }})
   scale(1.15)"><use href="#ww-wind"/></g>
<text x="{{ wind_text_x }}" y="{{ y_metrics }}" font-size="{{ font_s }}"
      fill="{{ c_fg }}" font-family="Roboto">{{ wind_text }}</text>
{%- endif -%}
{%- if solar_text -%}
<g transform="translate({{ solar_icon_x }}, {{ y_metrics - 7 }})
   scale(1.15)"><use href="#ww-horizon"/></g>
<text x="{{ left_right }}" y="{{ y_metrics }}" font-size="{{ font_s }}"
      text-anchor="end" fill="{{ c_fg }}"
      font-family="Roboto">{{ solar_text }}</text>
{%- endif -%}
{#- The two-hourly strip. -#}
{%- for hr in hours -%}
<text x="{{ hr.cx }}" y="{{ y_hour_label }}" font-size="{{ font_s }}"
      text-anchor="middle" fill="{{ c_fg }}"
      font-family="Roboto">{{ hr.label }}</text>
{%- if hr.icon -%}
<g transform="translate({{ hr.cx }}, {{ hour_icon_cy }})
   scale({{ hour_scale }})"><use href="#{{ hr.icon }}"/></g>
{%- endif -%}
{%- if hr.temp.show -%}
<text x="{{ hr.cx }}" y="{{ y_hour_temp }}" font-size="{{ font_m }}"
      font-weight="500" text-anchor="middle" fill="{{ c_fg }}"
      font-family="Roboto"
  >{%- if hr.temp.neg %}<tspan font-size="{{ minus_m }}">&#8722;</tspan><tspan dx="{{ dx_m }}">{{ hr.temp.text }}</tspan>{% else %}{{ hr.temp.text }}{% endif -%}</text>
{%- endif -%}
{%- endfor -%}
{%- if rain_d -%}
<path d="{{ rain_d }}" fill="{{ c_fg }}"/>
<line x1="{{ right_x }}" y1="{{ rain_mid }}"
      x2="{{ right_right }}" y2="{{ rain_mid }}"
      stroke="{{ c_fg }}" stroke-width="1" stroke-dasharray="4 4"/>
<text x="{{ right_x }}" y="{{ y_caption }}" font-size="{{ font_s }}"
      fill="{{ c_fg }}" font-family="Roboto">{{ caption }}</text>
{%- if rain_peak -%}
<text x="{{ right_right }}" y="{{ y_caption }}" font-size="{{ font_s }}"
      text-anchor="end" fill="{{ c_fg }}"
      font-family="Roboto">{{ rain_peak }}</text>
{%- endif -%}
{%- endif -%}
<line x1="{{ margin }}" y1="{{ y_rule }}" x2="{{ w - margin }}"
      y2="{{ y_rule }}" stroke="{{ c_fg }}" stroke-width="1.5"/>
{#- The day strip. -#}
{%- for d in days -%}
<text x="{{ d.cx }}" y="{{ y_day_label }}" font-size="{{ font_s }}"
      text-anchor="middle" fill="{{ c_fg }}"
      font-family="Roboto">{{ d.label }}</text>
{%- if d.icon -%}
<g transform="translate({{ d.cx }}, {{ day_icon_cy }})
   scale({{ day_scale }})"><use href="#{{ d.icon }}"/></g>
{%- endif -%}
{%- if d.temp.show -%}
<text x="{{ d.cx }}" y="{{ y_day_temp }}" font-size="{{ font_m }}"
      font-weight="500" text-anchor="middle" fill="{{ c_fg }}"
      font-family="Roboto"
  >{%- if d.temp.neg %}<tspan font-size="{{ minus_m }}">&#8722;</tspan><tspan dx="{{ dx_m }}">{{ d.temp.text }}</tspan>{% else %}{{ d.temp.text }}{% endif -%}</text>
{%- endif -%}
{%- if d.prob -%}
<text x="{{ d.cx }}" y="{{ y_day_prob }}" font-size="{{ font_s }}"
      text-anchor="middle" fill="{{ c_fg }}"
      font-family="Roboto">{{ d.prob }}</text>
{%- endif -%}
{%- if d.remark -%}
<text x="{{ d.cx }}" y="{{ y_day_remark }}" font-size="{{ font_s }}"
      text-anchor="middle" fill="{{ c_fg }}"
      font-family="Roboto">{{ d.remark }}</text>
{%- endif -%}
{%- endfor -%}
{%- endif -%}
</svg>